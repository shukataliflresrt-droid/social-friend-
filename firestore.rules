rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isChatMember(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function isCallMember(callId) {
      return signedIn() &&
        (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
         request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
    }

    // Public directory fields only: uid, displayName, email.
    match /publicUsers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        friendshipId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update, delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /chats/{chatId} {
      allow create: if signedIn() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members;
      allow read, update: if isChatMember(chatId) &&
        request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow create: if signedIn() &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.calleeId is string &&
        request.resource.data.calleeId != request.auth.uid;
      allow read: if isCallMember(callId);
      allow update: if isCallMember(callId) &&
        request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, create: if candidateCollection in ['callerCandidates', 'calleeCandidates'] &&
          isCallMember(callId);
        allow update, delete: if false;
      }
    }

    // Existing application collections. Tighten these further before public launch.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}